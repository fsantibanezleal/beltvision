# Normalize line endings: LF in the repo, checkout as-is per platform tooling.
* text=auto eol=lf

# Explicit text files
*.py    text
*.toml  text
*.md    text
*.yml   text
*.yaml  text
*.cfg   text
*.txt   text

# Binary assets (never diffed or eol-normalized)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.onnx  binary
